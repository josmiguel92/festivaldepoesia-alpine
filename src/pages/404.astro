---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/theme.config";
---

<BaseLayout title={`Página no encontrada - ${SITE.name}`} description="La página no pudo ser encontrada.">
  <div class="mx-auto max-w-2xl px-5 py-32 text-center">
    <div class="font-serif text-7xl font-semibold">404</div>
    <h1 class="mt-4 font-serif text-2xl font-semibold">Página no encontrada</h1>
    <p class="mt-3 text-muted-foreground">
      La página que buscas no se encuentra. Puede haber sido movida, renombrada o eliminada.
    </p>
    <div class="mt-6 flex justify-center gap-3">
      <a href="/" class="rounded-md bg-foreground px-4 py-2 text-sm font-medium text-background hover:opacity-90">
        Volver al inicio
      </a>
      <a href="/blog" class="rounded-md border border-border px-4 py-2 text-sm hover:bg-muted">
        Explorar el archivo
      </a>
    </div>
  </div>
</BaseLayout>
