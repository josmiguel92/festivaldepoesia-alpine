---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const poets = await getCollection('poets');
  return poets.map((poet) => ({
    params: { slug: poet.id },
    props: { poet },
  }));
}

const { poet } = Astro.props;
const { Content } = await render(poet);

// Fetch poems for this poet
const allPoems = await getCollection('poems');
const poetPoems = allPoems.filter(poem => poem.data.poetId === poet.id);

// Render the poems
const renderedPoems = await Promise.all(
  poetPoems.map(async (poem) => {
    const rendered = await render(poem);
    return { 
      ...poem, 
      Content: rendered.Content 
    };
  })
);
---

<BaseLayout title={`${poet.data.name} - Directorio de Poetas`} description={`Perfil y poemas de ${poet.data.name}`}>
  <main class="max-w-[800px] mx-auto px-6 py-12 md:py-20 lg:py-24">
    <div class="flex flex-col md:flex-row gap-10 items-start mb-16">
      {poet.data.photo && (
        <div class="w-40 h-40 md:w-56 md:h-56 flex-shrink-0 mx-auto md:mx-0">
          <Image 
            src={poet.data.photo} 
            alt={`Foto de ${poet.data.name}`} 
            width={250} 
            class="w-full h-full rounded-full shadow-lg object-cover border-4 border-page-background-alt" 
          />
        </div>
      )}
      
      <div class="flex-1 w-full text-center md:text-left mt-4 md:mt-0">
        <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-primary-text mb-6">
          {poet.data.name}
        </h1>
        
        <div class="prose prose-lg prose-neutral prose-a:text-secondary-text hover:prose-a:text-primary-text max-w-none text-secondary-text mx-auto md:mx-0">
          <Content />
        </div>
      </div>
    </div>

    {renderedPoems.length > 0 && (
      <div class="mt-20">
        <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-primary-text mb-10 pb-4 border-b border-divider-color">
          Poemas
        </h2>
        
        <div class="space-y-16">
          {renderedPoems.map((poem) => (
            <article class="bg-page-background-alt/30 p-8 rounded-2xl border border-divider-color/50">
              <h3 class="text-xl md:text-2xl font-medium text-primary-text mb-6">
                {poem.data.title}
              </h3>
              <div class="prose prose-lg prose-neutral prose-a:text-secondary-text hover:prose-a:text-primary-text max-w-none text-secondary-text font-serif leading-relaxed">
                <poem.Content />
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
  </main>
</BaseLayout>
