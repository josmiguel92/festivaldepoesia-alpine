---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const poets = await getCollection('poets');

// Sort poets alphabetically by name
poets.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<BaseLayout title="Directorio de Poetas" description="Directorio oficial de poetas">
  <main class="max-w-[1000px] mx-auto px-6 py-12 md:py-20 lg:py-24">
    <div class="text-center mb-16 border-b border-divider-color pb-10">
      <h1 class="text-4xl md:text-5xl font-semibold tracking-tight text-primary-text mb-4">
        Directorio de Poetas
      </h1>
      <p class="text-xl text-secondary-text max-w-2xl mx-auto">
        Conoce a los autores de nuestra colección, explora sus biografías y descubre sus poemas seleccionados.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 md:gap-12">
      {poets.map(poet => (
        <a href={`/directorio/poetas/${poet.id}`} class="group flex flex-col items-center text-center transition-transform hover:-translate-y-2">
          <div class="w-32 h-32 md:w-40 md:h-40 mb-4 rounded-full overflow-hidden border-4 border-transparent group-hover:border-accent-color/30 transition-all shadow-md">
            {poet.data.photo ? (
              <Image 
                src={poet.data.photo} 
                alt={`Foto de ${poet.data.name}`}
                width={200}
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="w-full h-full bg-page-background-alt flex items-center justify-center relative overflow-hidden">
                <div class="absolute inset-0 z-0 opacity-10" style="background-image: radial-gradient(var(--foreground) 1px, transparent 1px); background-size: 8px 8px;"></div>
                <div class="absolute inset-0 z-0 bg-gradient-to-tr from-page-background-alt via-transparent to-transparent"></div>
                <span class="relative z-10 text-4xl text-secondary-text/40 font-light">{poet.data.name.charAt(0)}</span>
              </div>
            )}
          </div>
          <h2 class="text-lg md:text-xl font-medium text-primary-text group-hover:text-accent-color transition-colors">
            {poet.data.name}
          </h2>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
